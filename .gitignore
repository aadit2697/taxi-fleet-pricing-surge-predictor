# files needed to run streamlit_app.py (data/pricing_input.parquet,
# data/taxi_zone_lookup.csv, data/yellow_tripdata_2024-01_head.csv) are kept.
data/yellow_tripdata_2024-01.parquet
data/*.parquet.gz

